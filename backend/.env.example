# Copy to .env for local development: cp .env.example .env
# On Cloud Run these come from --set-env-vars / --set-secrets (Secret Manager), not this file.

ENVIRONMENT=local            # local | production (production disables /docs)
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Groq API key (https://console.groq.com) — never commit a real value
GROQ_API_KEY=

MAX_UPLOAD_MB=10
