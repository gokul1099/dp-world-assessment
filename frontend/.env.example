# Copy to .env.local for local development: cp .env.example .env.local
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time,
# so never put secrets here. In Vercel, set this per environment (Production/Preview).

# Base URL of the FastAPI backend (local: uvicorn on 8080, prod: Cloud Run URL)
NEXT_PUBLIC_API_URL=http://localhost:8080

# true = use the fake API in src/api/mock.ts (frontend work before the backend endpoint exists)
NEXT_PUBLIC_API_MOCK=false
